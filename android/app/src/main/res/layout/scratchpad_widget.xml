<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_scratchpad_bg"
    android:padding="12dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="5dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_widget_note"
            android:contentDescription="@string/scratchpad_widget_title" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/scratchpad_widget_title"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_header_text"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/widget_sub_text"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/widget_btn_add"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_btn_circle_bg"
            android:src="@drawable/ic_widget_add"
            android:scaleType="centerInside"
            android:contentDescription="Add note" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider"
        android:layout_marginBottom="6dp" />

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/widget_body_text"
            android:ellipsize="end"
            android:maxLines="12" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/scratchpad_widget_empty"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/widget_empty_text"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
