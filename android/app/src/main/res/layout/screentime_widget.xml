<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_screentime_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_screentime_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Header: Icon + Label "Screen Time Today" -->
    <LinearLayout
        android:id="@+id/widget_screentime_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_screentime_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_clock_indigo"
            android:contentDescription="@string/screentime_widget_title" />

        <TextView
            android:id="@+id/widget_screentime_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="@string/screentime_widget_title"
            android:textColor="@color/widget_screentime_label"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Normal State: Large bold duration (e.g. 6h 30m) -->
    <TextView
        android:id="@+id/widget_screentime_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="0m"
        android:textColor="@color/widget_screentime_duration"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Unavailable State: Permission Needed / Tap to Setup -->
    <LinearLayout
        android:id="@+id/widget_screentime_unavailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_screentime_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screentime_widget_perm_needed"
            android:textColor="@color/widget_screentime_error"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_screentime_status_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/screentime_widget_tap_to_setup"
            android:textColor="@color/widget_screentime_label"
            android:textSize="10sp"
            android:fontFamily="sans-serif"
            android:singleLine="true" />
    </LinearLayout>

</LinearLayout>
