# Neon (Serverless PostgreSQL) Database Connection
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]/[DB_NAME]?sslmode=require&channel_binding=require"

# Groq API for AI Secretary (llama-3.3-70b-versatile)
VITE_GROQ_API_KEY=

# Gemini API Key for Voice Assist, Live API, and Voice Commands (Server-side only)
GEMINI_API_KEY=
